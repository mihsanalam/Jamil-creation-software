DATABASE_HOST=localhost
DATABASE_USER=root
DATABASE_PASSWORD=your_password_here
DATABASE_NAME=jamilcreations

# Secret used by NextAuth to sign session JWTs.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# Cloudinary account used to host fabric photos (free tier is fine).
# Get these from the Cloudinary console dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Backups (all optional — see "Backups" in README.md) ──────────────────
# Where scripts/backup-db.cjs writes its .sql dumps (default: ./backups).
# BACKUP_DIR=D:\jamilcreations-backups
# How many days of dumps to keep (default: 14).
# BACKUP_KEEP_DAYS=14
# Full path to mysqldump when it is not on PATH (it is not, on a default
# Windows install — this script already tries the MySQL Server 8.0 location).
# MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
# MySQL port, when it is not the default 3306.
# DATABASE_PORT=3306
